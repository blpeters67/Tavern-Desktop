{
  "name": "tavern-desktop",
  "version": "0.1.6",
  "private": true,
  "description": "A dedicated Windows home for Tavern",
  "author": "Benji",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:app": "electron . --smoke-test",
    "assets": "node scripts/build-icon.cjs",
    "dist": "npm run assets && electron-builder --win nsis --x64 --publish never",
    "pack": "npm run assets && electron-builder --win --dir --x64",
    "test:updater": "electron scripts/updater-test.cjs",
    "release:verify": "node scripts/verify-release.cjs"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "sharp": "0.35.4"
  },
  "build": {
    "appId": "site.benjis.tavern.desktop",
    "productName": "Tavern",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json",
      "LICENSE.md"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Tavern-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tavern",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "blpeters67",
        "repo": "Tavern-Desktop",
        "releaseType": "release"
      }
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "extraFiles": [
      {
        "from": "LICENSE.md",
        "to": "LICENSE-Tavern.md"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blpeters67/Tavern-Desktop.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
